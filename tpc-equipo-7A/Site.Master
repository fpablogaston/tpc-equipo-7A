<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="tpc_equipo_7A.Site" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .user-badge {
            position: fixed;
            top: 10px;
            right: 10px;
            background-color: #0d6efd;
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 2rem;
            z-index: 1050;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        }
    </style>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</head>
<body style="background-color: #f0f2f5; display: flex; flex-direction: column; min-height: 100vh;">
    <form id="form1" runat="server" style="flex: 1; display: flex; flex-direction: column;">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
        <header style="background-color: #000C8E; height: auto; padding: 0.5rem 1rem;" class="text-white">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold fs-3 me-4" href="Default.aspx">Tienda Online</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <div class="navbar-nav mx-auto align-items-center gap-2">
                            <a class="btn btn-outline-light" href="Default.aspx">Inicio</a>
                            <!--a class="btn btn-outline-light" href="Productos.aspx">Productos</a-->
                            <asp:DropDownList ID="ddlCategorias" runat="server"
                                CssClass="btn btn-outline-light position-relative"
                                Style="width: auto; height: 38px"
                                AutoPostBack="true" OnSelectedIndexChanged="ddlCategorias_SelectedIndexChanged">
                            </asp:DropDownList>
                            <asp:PlaceHolder ID="phAdmin" runat="server">
                                <a class="btn btn-outline-warning fw-bold" href="PanelAdmin.aspx">Admin Panel</a>
                            </asp:PlaceHolder>

                            <asp:PlaceHolder ID="phLogin" runat="server">
                                <a class="btn btn-success" href="Login.aspx">Ingresar</a>
                            </asp:PlaceHolder>
                            <asp:PlaceHolder ID="phLogout" runat="server">
                                <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-danger"
                                    OnClick="btnLogout_Click" OnClientClick="confirmarLogout(); return false">Cerrar Sesión
                                </asp:LinkButton>
                            </asp:PlaceHolder>
                            <a class="btn btn-outline-light position-relative" data-bs-toggle="offcanvas" href="#offcanvasExample" role="button" aria-controls="offcanvasExample">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cart-fill me-1" viewBox="0 0 16 16" style="vertical-align: -3px;">
                                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
                                </svg>
                                <asp:UpdatePanel ID="UPBadge" runat="server" UpdateMode="Conditional">
                                    <ContentTemplate>
                                        <span id="badgeCarrito" runat="server"
                                            class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0
                                        </span>
                                    </ContentTemplate>
                                </asp:UpdatePanel>
                            </a>
                            <asp:PlaceHolder ID="phUser" runat="server" Visible="false">
                                <div class="badge badge-pill badge-dark">
                                    Hola,
                                    <asp:Label ID="lblUser" runat="server" />
                                </div>
                            </asp:PlaceHolder>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <div style="flex: 1;">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <asp:UpdatePanel runat="server" ID="UPMaster" UpdateMode="Always">
            <ContentTemplate>
                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="offcanvasExampleLabel">Carrito</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <div data-bs-spy="scroll" data-bs-target="#navbar-example2" data-bs-root-margin="0px 0px -40%" data-bs-smooth-scroll="true" class="scrollspy-example bg-body-tertiary p-3 rounded-2" tabindex="0">
                            <div style="max-height: 670px; overflow-y: auto;">
                                <asp:Repeater ID="repCarrito" runat="server" OnItemCommand="repCarrito_ItemCommand">
                                    <ItemTemplate>
                                        <div class="card mb-3 shadow-sm" style="max-width: 540px;">
                                            <div class="row g-0 align-items-center">
                                                <div class="col-md-4 p-2">
                                                    <img src="<%# Eval("Producto.ImagenUrl") %>" class="img-fluid rounded" alt="Producto"
                                                        onerror="this.src='https://placehold.co/100?text=No+Image'"
                                                        style="object-fit: contain; height: 80px; width: 100%;">
                                                </div>
                                                <div class="col-md-8">
                                                    <div class="card-body p-2">
                                                        <h6 class="card-title text-truncate"><%# Eval("Producto.Nombre") %></h6>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <asp:HiddenField ID="hfIdProducto" runat="server" Value='<%# Eval("Producto.Id") %>' />
                                                            <asp:TextBox ID="txtCantidad" runat="server"
                                                                CssClass="form-control form-control-sm"
                                                                AutoPostBack="true"
                                                                OnTextChanged="txtCantidad_TextChanged"
                                                                Text='<%# Eval("Cantidad") %>' Width="50px"></asp:TextBox>
                                                            <asp:LinkButton ID="btnEliminar" runat="server"
                                                                Text="X" CssClass="btn btn-sm btn-danger"
                                                                CommandName="EliminarItem"
                                                                CommandArgument='<%# Eval("Producto.Id") %>' />
                                                            <span class="fw-bold text-primary ms-2">
                                                                <%# "$" + Eval("PrecioTotal", "{0:N2}") %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </ItemTemplate>
                                </asp:Repeater>
                            </div>
                            <div class="container border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">Total Productos:</span>
                                    <asp:Label ID="lblTotalItems" runat="server" Text="0" CssClass="fw-bold"></asp:Label>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="h5 mb-0">Total:</span>
                                    <span class="h5 mb-0 text-primary">$<asp:Label ID="lblTotalPrice" runat="server" Text="0.00"></asp:Label></span>
                                </div>
                                <div class="d-grid">
                                    <asp:Button ID="btnVerCarrito" Text="Ver Carrito Completo" runat="server" CssClass="btn btn-primary btn-lg" OnClick="btnVerCarrito_Click" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ContentTemplate>
        </asp:UpdatePanel>
               

        <!--script>
            function mostrarOffcanvas() {
                var off = document.getElementById('offcanvasExample');
                if (!off) return;


                var instance = bootstrap.Offcanvas.getOrCreateInstance(off);
                instance.show();
            }

            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                mostrarOffcanvas();
            });
        </script-->
        <footer>
            <h6 class="text-center" style="padding: 50px">Equipo 7A Programacion III 2025</h6>
        </footer>
        <script>
            document.addEventListener('keydown', function (e) {
                if (e.key === "Enter" && e.target.tagName === "INPUT") {
                    e.preventDefault(); 
                    e.target.blur();
                }
            });
        </script>
         <script>
             function confirmarLogout() {
                 Swal.fire(
                     {
                         title: 'Volvé pronto!',
                         text: '¿Seguro que deseas cerrar sesión?',
                         icon: 'warning',
                         showCancelButton: true,
                         confirmButtonText: 'Sí, salir',
                         cancelButtonText: 'Cancelar'
                     }).then((result) => {
                         if (result.isConfirmed) {
                             __doPostBack('<%= btnLogout.UniqueID %>', '');
                 }
             });
             }
         </script>
    </form>
</body>
</html>
